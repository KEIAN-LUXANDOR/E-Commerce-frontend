FROM node:22-bookworm AS build
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
RUN npm run build
RUN node -e "const p=require('./package.json');process.exit(p.dependencies&&p.dependencies.next?0:1)" && npm prune --omit=dev --no-audit --no-fund || echo "keeping all packages"
RUN rm -rf .next/cache

FROM scratch
COPY --from=build /app /
